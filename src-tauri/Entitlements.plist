<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened-runtime release builds block Apple Events unless this
	     entitlement is present, even after the user grants Automation
	     permission. Trace uses Apple Events solely to read the active browser
	     tab's URL (domain only); see NSAppleEventsUsageDescription in Info.plist. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
